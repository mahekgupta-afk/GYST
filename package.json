{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "test:tz": "for tz in UTC America/Los_Angeles Pacific/Kiritimati Pacific/Pago_Pago Asia/Kolkata Europe/London; do echo \"TZ=$tz\"; TZ=$tz vitest run tests/regression.test.ts tests/workbook.test.ts 2>&1 | grep -E 'Tests |FAIL|×'; done"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@neondatabase/serverless": "^1.2.0",
    "jspdf": "^2.5.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^25.0.1",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
